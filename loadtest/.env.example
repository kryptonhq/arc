# Copy to loadtest/.env, fill in, then: set -a; source loadtest/.env; set +a
# Credentials come from the dashboard: create an app for load testing (client
# events off, presence limits off) and copy its id, key and secret.
ARC_WS_URL=wss://arc.example.com
ARC_API_URL=https://arc.example.com
ARC_APP_ID=
ARC_APP_KEY=
ARC_APP_SECRET=
# Optional: lets soak.js read /metrics when ARC_METRICS_AUTH_TOKEN is set on the server.
ARC_METRICS_TOKEN=
