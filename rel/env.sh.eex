#!/bin/sh
# Node naming for clustering. Nodes are named arc@<ip> so libcluster's gossip and DNS
# strategies can reach each other; override RELEASE_NODE to name nodes yourself.
if [ "${ARC_CLUSTER_STRATEGY:-none}" != "none" ]; then
  export RELEASE_DISTRIBUTION=name
  if [ -z "${RELEASE_NODE:-}" ]; then
    ip=$(hostname -i 2>/dev/null | awk '{print $1}')
    export RELEASE_NODE="<%= @release.name %>@${ip}"
  fi
fi
